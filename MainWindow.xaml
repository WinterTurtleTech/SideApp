<Window x:Class="SideApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SideApp" Background="#333333"
        xmlns:Model="clr-namespace:SideApp.Model"
        mc:Ignorable="d" WindowStyle="None" WindowStartupLocation="Manual"
        Title="MainWindow" Height="150" Width="300" Left="1232" Top="705"
        ResizeMode="NoResize" Loaded="Window_Loaded" Closed="Window_Closed" 
        BorderThickness="0.5" BorderBrush="WhiteSmoke" ShowActivated="False"
        Visibility="{Binding WindowVisibility, Mode=TwoWay, FallbackValue=Visible}" >

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0"/>
    </WindowChrome.WindowChrome>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Foreground="WhiteSmoke" Background="Transparent" Height="Auto" Width="180" Grid.RowSpan="2"
                   Margin="4 2 0 0" Grid.ColumnSpan="2" TargetUpdated="tbError_TargetUpdated" 
                   Text="{Binding Error, TargetNullValue=Can you guess this kanji?, NotifyOnTargetUpdated=True,
                   FallbackValue=ErrorText}" HorizontalAlignment="Left" Name="tbError" TextWrapping="Wrap" />
        <Grid Grid.Row="0" Grid.ColumnSpan="2">
            <StackPanel Grid.ColumnSpan="2" HorizontalAlignment="Right" Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Height" Value="30" />
                        <Setter Property="Width" Value="30" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Foreground" Value="WhiteSmoke"/>
                        <Setter Property="FontWeight" Value="Thin" />
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="Foreground" Value="WhiteSmoke"/>
                        <Setter Property="FontWeight" Value="Thin" />
                    </Style>
                </StackPanel.Resources>

                <ToggleButton x:Name="tbListsToggle" Width="30"
                              Background="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" ToolTip="Choose the lists you want to be included">
                        <TextBlock Text="L" Margin="4 0 0 0" />
                        <TextBlock Text="▾" Margin="-1.5 0 0 -1" FontSize="10" VerticalAlignment="Bottom"/>
                    </StackPanel>                    
                </ToggleButton>

                <Popup IsOpen="{Binding IsChecked, ElementName=tbListsToggle}"
                       PlacementTarget="{Binding ElementName=tbListsToggle}"
                       Placement="Top" StaysOpen="False"
                       AllowsTransparency="False">
                    <Border BorderThickness="0.5" BorderBrush="WhiteSmoke">
                        <ItemsControl ItemsSource="{Binding AvaibleLists}" Background="#333333">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayName}"
                                              IsChecked="{Binding IsSelected}"
                                              Margin="2,3" Foreground="WhiteSmoke"
                                              />                                    
                                </DataTemplate>                                    
                            </ItemsControl.ItemTemplate>                            
                        </ItemsControl>
                    </Border>
                </Popup>

                <ToggleButton x:Name="tbTimeControl" Width="30"
                              Background="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" ToolTip="Change the waiting time">
                        <TextBlock Text="T" Margin="4 0 0 0" />
                        <TextBlock Text="▾" Margin="-1.5 0 0 -1" FontSize="10" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </ToggleButton>

                <Popup IsOpen="{Binding IsChecked, ElementName=tbTimeControl}"
                       PlacementTarget="{Binding ElementName=tbTimeControl}"
                       Placement="Top" StaysOpen="False"
                       AllowsTransparency="True" HorizontalOffset="-137">
                    <Border BorderThickness="0.5" BorderBrush="WhiteSmoke">
                        <ItemsControl Background="#333333">
                            <ItemsControl.Items>
                                <StackPanel Orientation="Vertical">
                                    <StackPanel.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="Foreground" Value="WhiteSmoke"/>
                                            <Setter Property="FontWeight" Value="Thin" />
                                            <Setter Property="Margin" Value="3" />
                                        </Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="Foreground" Value="WhiteSmoke"/>
                                            <Setter Property="FontWeight" Value="Thin" />
                                            <Setter Property="Margin" Value="3" />
                                        </Style>
                                    </StackPanel.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Min time (min) for the timer:"/>
                                    <TextBox Width="70" Text="{Binding MinTime}"/>
                                </StackPanel>
                                    <Separator/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Max time (min) for the timer:"/>
                                    <TextBox Width="70" Text="{Binding MaxTime}"/>
                                </StackPanel>
                                </StackPanel>
                            </ItemsControl.Items>
                        </ItemsControl>
                    </Border>
                </Popup>

                <!--<Button Name="btLater" Content="+" Click="btLater_Click" ToolTip="Show this question 20 minutes later"/>-->
                <Button Name="btSkip" Content=">" Command="{Binding WaitingMode}" ToolTip="Skip current question"/>
                <Button Name="btClose" Content="X" Click="btClose_Click" ToolTip="Exit"/>
            </StackPanel>
        </Grid>
        
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Grid.RowSpan="2" VerticalAlignment="Top">
            <TextBlock Text="{Binding Meaning[0], StringFormat='It means [{0}]!', FallbackValue=Meaning, TargetNullValue=Why?}" 
                       Foreground="WhiteSmoke" FontSize="12" Margin="5 0 0 0" 
                       Name="lbMeaning" TextWrapping="Wrap" Width="100" HorizontalAlignment="Left" 
                       ToolTip="RightClick to see more meanings!">
                <TextBlock.ContextMenu>
                    <ContextMenu ItemsSource="{Binding Meaning}" />
                </TextBlock.ContextMenu>
            </TextBlock>
            <TextBlock Foreground="WhiteSmoke" Background="Transparent" Height="25" Width="120"
                       FontSize="18" TextAlignment="Center" Text="{Binding Emoticon, FallbackValue=?(´・ω・｀)}" Name="tbEmoticon"
                       HorizontalAlignment="Center" Margin="0,0,0,0" 
                       Grid.Row="1" Grid.ColumnSpan="3" />
            <TextBlock Text="{Binding Grade, StringFormat='Grade -> {0}', FallbackValue=Grade}" 
                       Foreground="WhiteSmoke" FontSize="12" Margin="0 0 0 0"
                       Grid.Row="1" Grid.ColumnSpan="2" Name="lbGrade" HorizontalAlignment="Right" Width="70" />
        </Grid>

        <Grid Grid.Row="2" Grid.ColumnSpan="2" Grid.RowSpan="2" >            
            <TextBlock Height="35" Width="100" Foreground="WhiteSmoke" FontSize="11" 
                   Text="{Binding Reading, TargetNullValue=404, FallbackValue=Reading}"
                   TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5 -2 0 0"/>
            <TextBlock Height="auto" Width="auto" Foreground="WhiteSmoke" FontSize="20" 
                   Text="{Binding Question, TargetNullValue=Haro, FallbackValue=Question}" 
                   TextAlignment="Center" Name="tblQuestion" Grid.ColumnSpan="2" />
            <Button Height="35" Width="50" VerticalAlignment="Top" HorizontalAlignment="Right" 
                    Margin="0 0 12.5 0" Background="Transparent" Foreground="WhiteSmoke" 
                    BorderThickness="3" BorderBrush="WhiteSmoke" Content="Answer" 
                    FontWeight="Light" FontSize="10" Name="btHint" Click="btHint_Click"
                    Visibility="{Binding HintVisibility}" Command="{Binding ShowHint}"/>
        </Grid>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" >
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Height" Value="40" />
                    <Setter Property="Width" Value="50" />
                    <Setter Property="VerticalAlignment" Value="Bottom" />
                    <Setter Property="Foreground" Value="WhiteSmoke" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="3" />
                    <Setter Property="BorderBrush" Value="WhiteSmoke" />
                    <Setter Property="FontWeight" Value="Light" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </StackPanel.Resources>

            <Button Name="btGuessAndExit" Click="btGuessAndExit_Click" FontSize="9" Margin="0,0,12,8"
                    Content="Guess/Exit" Command="{Binding Guessing}" />

            <TextBox Height="40" Width="150" Foreground="WhiteSmoke" Background="Transparent" 
                     BorderBrush="WhiteSmoke" Name="tbAnswer" BorderThickness="3"
                     TextAlignment="Center" FontSize="20" Margin="0 0.5 0 0" 
                     Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}" 
                     Model:KanaInputBehavior.IsEnabled="True" Model:KanaInputBehavior.Script="{Binding Script}" >
                <TextBox.InputBindings>
                    <KeyBinding Command="{Binding Guessing}" Key="Return"/>
                </TextBox.InputBindings>
            </TextBox>

            <Button Name="btGuess" FontSize="10" Margin="12,0,0,8" Click="btGuess_Click"
                    Content="Guess" Command="{Binding Guessing}" />

        </StackPanel>

    </Grid>
</Window>
