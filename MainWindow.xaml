<Window x:Class="SideApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SideApp" Background="#333333"
        mc:Ignorable="d" WindowStyle="None" WindowStartupLocation="Manual"
        Title="MainWindow" Height="150" Width="300" Left="1232" Top="705"
        ResizeMode="NoResize" >

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="5">
            <StackPanel Grid.ColumnSpan="2" HorizontalAlignment="Right" Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Height" Value="30" />
                        <Setter Property="Width" Value="30" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Foreground" Value="WhiteSmoke"/>
                    </Style>
                </StackPanel.Resources>
                <Button Name="btLater" Content="+" Click="btLater_Click"/>
                <Button Name="btSkip" Content=">" Click="btSkip_Click"/>
                <Button Name="btClose" Content="X" Click="btClose_Click"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal">
            <TextBlock Foreground="WhiteSmoke" Background="Transparent" Height="auto" Width="75"
                       FontSize="18" TextAlignment="Center" Text="?(´・ω・｀)" 
                       HorizontalAlignment="Center" Margin="110,0,0,0"/>
            <TextBlock Foreground="WhiteSmoke" Background="Transparent" Height="24" Width="113"
                       FontSize="10" Text="can you guess this kanji?" 
                       HorizontalAlignment="Center" Margin="2,10,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="5" Orientation="Vertical" >
        <TextBlock Height="40" Width="auto" Foreground="WhiteSmoke" FontSize="30" Text="Haro" 
                   TextAlignment="Center" Name="tblQuestion"  />            
        <TextBox Height="40" Width="150" Foreground="WhiteSmoke" Background="Transparent" 
                 BorderThickness="3" BorderBrush="WhiteSmoke" Name="tbAnswer"
                 TextAlignment="Center" FontSize="20" Margin="0,3,0,0" />
        </StackPanel>

        <Button Grid.Row="3" Grid.Column="1" Height="40" Width="50" 
        VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,13,13" 
        Background="Transparent" Foreground="WhiteSmoke" BorderThickness="3"
        BorderBrush="WhiteSmoke" Content="Guess" FontWeight="Light"
        FontSize="10" Name="btGuess" Click="btGuess_Click"                 
        VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

        <Button Grid.Row="3" Grid.Column="0" Height="40" Width="50" 
        VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="13,0,0,13" 
        Background="Transparent" Foreground="WhiteSmoke" BorderThickness="3"
        BorderBrush="WhiteSmoke" Content="Guess/Exit" FontWeight="Light"
        FontSize="9" Name="btGuessAndExit" Click="btGuessAndExit_Click" 
        VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

    </Grid>
</Window>
